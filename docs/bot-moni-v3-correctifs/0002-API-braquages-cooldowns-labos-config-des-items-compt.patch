+/**
+ * GET /api/stocks/items — la configuration des items suivis (`/config item`) :
+ * groupe d'affichage, vendable aux PNJ, visible dans le Stock Général, lien
+ * labo, multiplicateur. Sans elle, un client ne peut pas distinguer une
+ * drogue d'un matériel dans `/api/stocks`, ni regrouper comme le panneau
+ * Discord. Clés en minuscules, comme `item` dans `/api/stocks`.
+ */
+router.get('/items', async (req, res) => {
+  const items = configStore.get(req.apiUser!.guildId).ITEMS_BY_NAME;
+  res.json(Object.values(items).map(i => ({
+    item: i.name.toLowerCase(),
+    name: i.name,
+    group: i.stockGroup,
+    vente: i.vente,
+    visibleStock: i.visibleStock,
+    laboLie: i.laboLie,
+    laboLieRole: i.laboLieRole,
+    stockMultiplier: i.stockMultiplier,
+    displayOrder: i.displayOrder,
+  })));
+});
+
 /** GET /api/stocks/channels — liste des salons de logs de coffre suivis (avec leur `label`). `logs_coffres_admin` n'est inclus que pour un admin. */
 router.get('/channels', async (req, res) => {
